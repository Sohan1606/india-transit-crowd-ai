# Backend paths are relative to the project root for local development.
TRANSITCROWD_MODEL=backend/models/bengaluru-namma-metro/transitcrowd.joblib
TRANSITCROWD_DATA=data/processed/namma_metro_station_hourly.csv
TRANSITCROWD_SOURCE_METADATA=data/processed/namma_metro_station_hourly.metadata.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vite development uses the /api proxy by default. For Vercel set this at build time
# to the deployed API base, for example https://your-api.onrender.com/api
VITE_API_BASE=/api
